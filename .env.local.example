# ============================================================
# Speak for the Dead — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (Public — safe for browser) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Server-only — service role, NEVER expose) ─────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_URL=https://your-project.supabase.co

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase Edge Function (for server-side invocation) ─────
# Found in: Supabase Dashboard → Settings → API → Edge Functions URL
SUPABASE_EDGE_FUNCTION_URL=https://your-project.supabase.co/functions/v1
